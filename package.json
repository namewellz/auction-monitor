{
  "name": "telegram-auction-watcher",
  "version": "0.1.0",
  "description": "Historical auction lot collector with a local analytics dashboard.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "collector:dev": "tsx watch src/collector.ts",
    "collector:start": "node dist/collector.js",
    "collect:url": "tsx src/tools/collectUrl.ts",
    "collect:leilo-event": "tsx src/tools/collectLeiloEvent.ts",
    "revalidate:site": "tsx src/tools/revalidateSite.ts",
    "media:optimize": "tsx src/tools/optimizeMedia.ts",
    "leilo:dev": "tsx watch src/leiloApp.ts",
    "leilo:start": "node dist/leiloApp.js",
    "scrape": "tsx src/tools/scrape.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cycletls": "^2.0.5",
    "dotenv": "^16.4.7",
    "minio": "^8.0.7",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
